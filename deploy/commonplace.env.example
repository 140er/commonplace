# Copy outside the source checkout and replace the example paths and hostname.
COMMONPLACE_SOURCE_DIR=/path/to/commonplace/app
COMMONPLACE_ENV_FILE=/path/to/commonplace/.env
COMMONPLACE_DATA_DIR=/path/to/commonplace/data
COMMONPLACE_BASE_URL=https://hub.example.com
COMMONPLACE_ALLOWED_HOSTS=hub.example.com,127.0.0.1:8765
COMMONPLACE_IMAGE_TAG=local
# Optional gateway launcher kinds, comma-separated; both are disabled by default.
# Put this in the gateway environment file selected above.
# COMMONPLACE_HANDOFF_LAUNCHERS=command,webhook
# The project name comes from the Compose file; preserve its existing name.
# Optional outgoing mail, e.g. for `commonplace login-link --send`. Unset host = mail off.
# Put these in the gateway environment file selected above; keep it chmod 600.
# COMMONPLACE_SMTP_HOST=smtp.example.com
# COMMONPLACE_SMTP_PORT=587
# COMMONPLACE_SMTP_USER=commonplace@example.com
# COMMONPLACE_SMTP_PASSWORD=
# COMMONPLACE_SMTP_FROM=Commonplace <noreply@example.com>
# STARTTLS is on by default; set SSL=true (or port 465) for implicit TLS.
# COMMONPLACE_SMTP_STARTTLS=true
# COMMONPLACE_SMTP_SSL=false
