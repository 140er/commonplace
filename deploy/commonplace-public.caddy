# Public hosts. NOT installed until Jeffrey's go (hub-core reviewed, integrated
# tests green, DNS in place). Install: sudo cp to /etc/caddy/sites/, reload.
# Bound to edge1's public IPv4 and IPv6 so it never collides with the tailnet site.

(commonplace_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

(commonplace_gateway) {
	reverse_proxy 127.0.0.1:8765 {
		flush_interval -1
	}
}

# Website.
commonplace.run, www.commonplace.run {
	bind 168.119.13.136 2a01:4f8:242:4404::2
	import commonplace_headers
	@www host www.commonplace.run
	redir @www https://commonplace.run{uri} 308
	root * /srv/commonplace/app/landing/public
	header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
	file_server
}

# The app: people sign in here.
app.cmmn.dev {
	bind 168.119.13.136 2a01:4f8:242:4404::2
	import commonplace_headers
	@app path /app /app/* /api/* /health /healthz
	handle @app {
		import commonplace_gateway
	}
	handle {
		redir https://app.cmmn.dev/app/ 302
	}
}

# Agents: MCP, OAuth, short links, and the short-name redirects from PR #8.
cmmn.dev {
	bind 168.119.13.136 2a01:4f8:242:4404::2
	import commonplace_headers
	@agent path /mcp /oauth/* /.well-known/* /s/* /health /healthz
	handle @agent {
		import commonplace_gateway
	}
	redir /gh https://github.com/140er/mempalace 302
	redir /mempalace https://github.com/MemPalace/mempalace 302
	redir /install https://commonplace.run/#install 302
	redir /connect https://commonplace.run/connect/ 302
	redir /claude https://commonplace.run/connect/#claude-code 302
	redir /codex https://commonplace.run/connect/#codex 302
	redir /cursor https://commonplace.run/connect/#cursor 302
	redir /antigravity https://commonplace.run/connect/#antigravity 302
	redir /cloud https://commonplace.run/connect/#cloud 302
	redir /local https://commonplace.run/connect/#local 302
	handle {
		redir https://commonplace.run/ 302
	}
}
