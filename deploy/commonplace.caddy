# Replaces /etc/caddy/sites/commonplace.caddy; imported by edge1's Caddyfile.
edge1.tail6cee8c.ts.net {
	# Tailscale HTTPS is already configured on edge1. Keep its Caddy global config.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	@backend path /app* /api/* /mcp /health /healthz
	handle @backend {
		reverse_proxy 127.0.0.1:8765 {
			flush_interval -1
		}
	}

	handle {
		root * /srv/commonplace/app/landing/public
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
		file_server
	}
}

